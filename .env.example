# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- Content generation -----------------------------------------------------
# n8n webhook that returns the generated strategy JSON.
N8N_WEBHOOK_URL=

# --- Stripe paywall ---------------------------------------------------------
# Free accounts get GENERATION_LIMIT generations (src/lib/generate-content.functions.ts);
# an active subscription lifts the cap.

# Secret key from https://dashboard.stripe.com/apikeys (sk_test_... while testing).
STRIPE_SECRET_KEY=

# Price id of the recurring Pro plan, from the product's pricing section.
# This is the price_... id, not the prod_... id.
STRIPE_PRICE_ID=

# Signing secret for the webhook endpoint below (whsec_...). Shown once when
# you add the endpoint in Stripe, or printed by `stripe listen` in local dev.
STRIPE_WEBHOOK_SECRET=

# Service role key from Supabase (Project settings -> API). The webhook is the
# only writer to public.subscriptions, and needs to bypass RLS to do it.
# Server-side only -- this key can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed app, no trailing slash. Used to build Stripe's
# success/cancel/return URLs, which must never come from the browser.
APP_URL=https://your-app.example.com

# --- Optional ---------------------------------------------------------------
# Display-only label on the upgrade card, e.g. "$29/mo". Left blank, the card
# shows no price and Stripe Checkout is where the amount first appears.
VITE_PRO_PRICE_LABEL=
