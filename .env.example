# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# A local .env only affects `npm run dev`. Set these where the app is DEPLOYED
# too, or the paywall won't work in production.

# --- Content generation -----------------------------------------------------
# n8n webhook that returns the generated strategy JSON.
N8N_WEBHOOK_URL=

# --- Stripe paywall ---------------------------------------------------------
# Free accounts get GENERATION_LIMIT (3) generations. Pro is unlimited, via a
# Stripe subscription or a coupon code. See STRIPE_SETUP.md.
#
# Run `npm run setup:stripe` to create the price and webhook and print
# STRIPE_PRICE_ID + STRIPE_WEBHOOK_SECRET. Nothing below needs the Stripe
# dashboard, and the publishable (pk_...) key is not used at all -- checkout is
# Stripe-hosted, so only the secret key ever matters and it stays server-side.

# Secret key, sk_test_... while testing, sk_live_... in production.
STRIPE_SECRET_KEY=

# Price id of the recurring Pro plan. This is the price_... id, not prod_...
# Printed by `npm run setup:stripe` (run it with PRICE_AMOUNT=4700 for $47).
STRIPE_PRICE_ID=

# Signing secret for the webhook endpoint (whsec_...). Printed once by
# `npm run setup:stripe`, or by `stripe listen` in local dev.
STRIPE_WEBHOOK_SECRET=

# Service role key from Supabase (Project settings -> API). The webhook is the
# only writer to public.subscriptions and needs to bypass RLS to do it.
# Server-side only -- this key can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed app, no trailing slash. Used to build Stripe's
# success/cancel/return URLs, which must never come from the browser.
APP_URL=https://your-app.example.com

# --- Optional ---------------------------------------------------------------
# Display-only labels on the plan cards. These do NOT change what anyone is
# charged -- STRIPE_PRICE_ID does. Defaults are "$47" and "per month".
VITE_PRO_PRICE_LABEL=
VITE_PRO_PRICE_CADENCE=
